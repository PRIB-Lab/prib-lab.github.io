{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prib-labs",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "priblabs.com",
      "custom_domain": true
    },
    {
      "pattern": "www.priblabs.com",
      "custom_domain": true
    }
  ]
}
